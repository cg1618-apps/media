[Unit]
Description=Media tracker: weekly cover sync, Wednesdays at 04:20 Asia/Taipei

[Timer]
OnCalendar=Wed *-*-* 04:20:00
# The box can be off when a run is due - a power cut, a move. Without this a
# missed run is lost silently, which is worse than it looks - the whole point
# of the dead-man's switch is that a run that never happened is visible.
Persistent=true
Unit=media-covers.service

[Install]
WantedBy=timers.target
